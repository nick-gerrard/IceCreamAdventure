local C = require("constants")

local Roach = {
	Image = love.graphics.newImage("assets/roach.png"),
	isEnemy = true,
}

function Roach.new(x, y)
	-- TODO: add width, height, vx for patrol AI
    local instance = { x=x, y=y, width=C.TILE_SIZE, height=C.TILE_SIZE, vx=0, active=true}
    setmetatable(instance, {__index = Roach})
    return instance
end

-- TODO: add update(dt, level, entities) — patrol back and forth, reverse at walls and platform edges

function Roach:draw()
	love.graphics.draw(self.Image, self.x, self.y)
end

return Roach
